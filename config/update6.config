# update6 (cumulative): observability for kernel-level analysis of the AI stack.
#
# WHY CUMULATIVE: this project's configure() merges base.config with exactly one delta
# (base + config/updateN.config); it does not stack earlier deltas. A delta carrying only its own
# additions would therefore *remove* what earlier updates added - update5 alone would have dropped
# update4's FUNCTION_TRACER/DYNAMIC_FTRACE/BTF, and with them the tracing this analysis depends on.
# (That trap was found while preparing this file: the update5 build was stopped before it could
# install a kernel without the tracer.) update5.config stays in the tree as the record of what it
# intended to add; update6 restates everything the kernel must have.
#
# Carried forward from update4 (installed 2026-09-23):
CONFIG_RCU_EXPERT=y
CONFIG_RCU_BOOST=y
CONFIG_RCU_BOOST_DELAY=500
CONFIG_LOCKUP_DETECTOR=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
# From update5:
CONFIG_FUNCTION_PROFILER=y
CONFIG_FUNCTION_GRAPH_RETVAL=y
# New in update6, each tied to a question this programme has:
CONFIG_UPROBES=y
CONFIG_UPROBE_EVENTS=y
CONFIG_OSNOISE_TRACER=y
CONFIG_HWLAT_TRACER=y
CONFIG_IRQSOFF_TRACER=y
CONFIG_PREEMPT_TRACER=y
CONFIG_TIMERLAT_TRACER=y
CONFIG_STACK_TRACER=y
CONFIG_HW_PERF_EVENTS=y
