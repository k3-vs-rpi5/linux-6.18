# update5: kernel-side observability the first analysis round could not use.
#
# Rationale (measured before this delta was written):
#  * available_tracers on update4 offers function and function_graph, but the *function profiler*
#    (accumulated call counts and total time per kernel function) is absent, which is why the kernel
#    time ranking of a decode run had to be assembled from graph blocks instead of read from
#    trace_stat/function*. CONFIG_FUNCTION_PROFILER supplies it.
#  * CONFIG_FUNCTION_GRAPH_RETVAL is added alongside so a graph trace carries the return value of
#    traced functions, which is the cheapest way to tell "which path was taken" from one trace.
#  * Nothing else changes: HUGETLBFS/HUGETLB_PAGE, KPROBES/KPROBE_EVENTS, BPF_EVENTS, FTRACE_SYSCALLS
#    and DEBUG_INFO_BTF are already enabled in base.config or update4.
CONFIG_FUNCTION_PROFILER=y
CONFIG_FUNCTION_GRAPH_RETVAL=y
