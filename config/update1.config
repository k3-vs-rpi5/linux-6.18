# Update 1: the RCU stall fix, and nothing else.
#
# Evidence: two high-concurrency llama-server runs wedged the K3 board, both
# reported as "rcu_preempt kthread starved for 175000 jiffies" (700 s at
# HZ=250) with khugepaged blocked behind it. The running kernel has
# PREEMPT_RCU and no RCU priority boosting, while its threaded IRQs run at
# SCHED_FIFO 50 with a 95 % RT budget on cpu0-7 - the same cores that carry
# the workload's host side.

# Boost the RCU grace-period kthread above the RT interrupt threads so it
# cannot be starved out of a CPU. RCU_BOOST depends on RCU_EXPERT, which is the
# switch that makes expert RCU tuning visible and changes no runtime behaviour
# by itself; without it kconfig silently drops RCU_BOOST and this delta would
# look applied while doing nothing.
CONFIG_RCU_EXPERT=y
CONFIG_RCU_BOOST=y
CONFIG_RCU_BOOST_DELAY=500

# Escalate instead of hanging: a soft lockup or a stuck task should be visible
# without a serial console attached. The panic itself is left to the operator
# through kernel.softlockup_panic, so a long legitimate stall does not reboot
# the board out from under a run.
CONFIG_LOCKUP_DETECTOR=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
