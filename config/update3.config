# Update 3: BTF for the running kernel, so the eBPF side can stop depending on
# hand-validated struct offsets.
#
# An update's configuration is complete rather than incremental, so this
# repeats update 1 and 2 first and then adds its own option.

# Boost the RCU grace-period kthread above the RT interrupt threads so it
# cannot be starved out of a CPU. RCU_BOOST depends on RCU_EXPERT.
CONFIG_RCU_EXPERT=y
CONFIG_RCU_BOOST=y
CONFIG_RCU_BOOST_DELAY=500

# Escalate instead of hanging: a soft lockup or a stuck task should be visible
# without a serial console attached. The panic itself is left to the operator.
CONFIG_LOCKUP_DETECTOR=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y

# BTF for vmlinux. The board's kernel has /sys/kernel/btf absent today, which is
# why the eBPF collectors validate every tracepoint field offset by hand before
# attaching and why they cannot use CO-RE at all. Module BTF is deliberately not
# enabled in this update: one variable at a time, and a module round can follow
# once this one is measured.
CONFIG_DEBUG_INFO_BTF=y
