# Update 4: function tracing, so BPF fentry/fexit programs can attach.
#
# An update's configuration is complete rather than incremental, so this
# repeats update 1, 2 and 3 first and then adds its own option.

# Boost the RCU grace-period kthread above the RT interrupt threads so it
# cannot be starved out of a CPU. RCU_BOOST depends on RCU_EXPERT.
CONFIG_RCU_EXPERT=y
CONFIG_RCU_BOOST=y
CONFIG_RCU_BOOST_DELAY=500

# Escalate instead of hanging: a soft lockup or a stuck task should be visible
# without a serial console attached. The panic itself is left to the operator.
CONFIG_LOCKUP_DETECTOR=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y

# BTF for vmlinux, which is what makes CO-RE collection possible at all, and
# module BTF, which update 3 deliberately left out until fentry on a vendor
# module was actually needed.
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y

# Function tracing. The vendor configuration leaves FUNCTION_TRACER off, and
# DYNAMIC_FTRACE depends on it, so /sys/kernel/tracing has no
# available_filter_functions and a BPF fentry program cannot be attached:
# measured on the stock kernel, bpf_program__attach() fails with -EFAULT.
# RISC-V installs a BPF trampoline at the function entry either through
# register_ftrace_direct() or, without DYNAMIC_FTRACE_WITH_DIRECT_CALLS, by
# patching the call site itself, so these two options are what the attach needs.
# This is what turns "fentry is cheaper than a tracepoint" into something the
# board can be asked instead of argued about.
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
